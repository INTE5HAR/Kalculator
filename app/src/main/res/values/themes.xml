<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Kalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Dynamic Theme Colors -->
        <item name="colorAppBackground">@color/light_background</item>
        <item name="colorTextPrimary">@color/light_text_primary</item>
        <item name="colorTextSecondary">@color/light_text_secondary</item>
        <item name="colorBtnNumber">@color/light_btn_number</item>
        <item name="colorBtnFunction">@color/light_btn_function</item>
        <item name="colorBtnOperator">@color/operator_color</item>
        <item name="colorBtnEquals">@color/equals_color</item>
    </style>

    <!-- Custom Theme Attributes -->
    <attr name="colorAppBackground" format="color" />
    <attr name="colorTextPrimary" format="color" />
    <attr name="colorTextSecondary" format="color" />
    <attr name="colorBtnNumber" format="color" />
    <attr name="colorBtnFunction" format="color" />
    <attr name="colorBtnOperator" format="color" />
    <attr name="colorBtnEquals" format="color" />

    <!-- Button Styles -->
    <style name="Widget.Kalculator.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Kalculator.Button.Number">
        <item name="backgroundTint">?attr/colorBtnNumber</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="rippleColor">#20000000</item>
    </style>

    <style name="Widget.Kalculator.Button.Function">
        <item name="backgroundTint">?attr/colorBtnFunction</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="rippleColor">#20000000</item>
    </style>

    <style name="Widget.Kalculator.Button.Clear">
        <item name="backgroundTint">?attr/colorBtnFunction</item>
        <item name="android:textColor">@color/clear_color</item>
        <item name="rippleColor">#30EF4444</item>
    </style>

    <style name="Widget.Kalculator.Button.Operator">
        <item name="backgroundTint">?attr/colorBtnOperator</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <style name="Widget.Kalculator.Button.Equals">
        <item name="backgroundTint">?attr/colorBtnEquals</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>
</resources>
